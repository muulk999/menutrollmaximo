-- Criar as Abas (Paineis)
local panels = {}
local tabNames = {"Jogador", "Órbita", "Veículos", "Kick Fling", "Itens"}

for i, name in ipairs(tabNames) do
    local panel = Instance.new("ScrollingFrame")
    panel.Name = name .. "Panel"
    panel.Size = UDim2.new(1, 0, 1, 0)
    panel.BackgroundTransparency = 1
    panel.BorderSizePixel = 0
    panel.CanvasSize = UDim2.new(0, 0, 0, 550)
    panel.Visible = (i == 1)
    panel.Parent = ContentContainer
    panels[name] = panel

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Padding = UDim.new(0, 6)
    layout.Parent = panel

    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, 0, 0, 32)
    tabBtn.BackgroundColor3 = (i == 1) and Color3.fromRGB(0, 120, 215) or Color3.fromRGB(50, 50, 60)
    tabBtn.Text = name
    tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.TextSize = 12
    tabBtn.Parent = TabButtonsContainer
    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 6)

    tabBtn.MouseButton1Click:Connect(function()
        for k, p in pairs(panels) do p.Visible = false end
        panel.Visible = true
        for _, b in ipairs(TabButtonsContainer:GetChildren()) do
            if b:IsA("TextButton") then b.BackgroundColor3 = Color3.fromRGB(50, 50, 60) end
        end
        tabBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    end)
end

