-- ==================== FUNÇÃO INTELIGENTE DE DETECÇÃO DE CARROS E MOTOS (COM SUPORTE A ASSENTOS DE MOTOS) ====================
local function isRealVehicle(model)
    if not model or not model:IsA("Model") then return false end
    
    -- Ignora avatares de jogadores
    if Players:GetPlayerFromCharacter(model) then return false end
    
    local nameLower = string.lower(model.Name)
    local hasVehicleKeyword = string.find(nameLower, "car") or string.find(nameLower, "moto") or string.find(nameLower, "veic") or string.find(nameLower, "bike") or string.find(nameLower, "veh") or string.find(nameLower, "auto") or string.find(nameLower, "scooter") or string.find(nameLower, "mota") or string.find(nameLower, "quad") or string.find(nameLower, "triciclo")
    
    local hasSeat = false
    local partsCount = 0
    
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then
            partsCount = partsCount + 1
        end
        -- Identifica tanto VehicleSeat quanto assentos normais de montagem em motos
        if obj:IsA("VehicleSeat") or obj:IsA("Seat") then
            hasSeat = true
        end
    end
    
    -- Se tiver assento e for um modelo válido (qualquer moto ou carro com assento no mapa)
    if hasSeat and partsCount >= 1 then
        return true
    elseif hasVehicleKeyword then
        return true
    end
    
    return false
end

local function refreshMapVehicles()
    for _, child in ipairs(MapVehicleList:GetChildren()) do 
        if child:IsA("TextButton") then child:Destroy() end 
    end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local maxRange = (vehicleEspPercentage / 100) * 500
    if maxRange < 5 then maxRange = 5 end

    local foundModels = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") or obj:IsA("Seat") then
            local model = obj.Parent
            if model and isRealVehicle(model) and not table.find(foundModels, model) then
                local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                if primary and myRoot then
                    local dist = (primary.Position - myRoot.Position).Magnitude
                    if dist <= maxRange then
                        table.insert(foundModels, model)
                    end
                end
            end
        end
    end

    for _, model in ipairs(foundModels) do
        local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
        local distVal = myRoot and primary and math.floor((primary.Position - myRoot.Position).Magnitude) or 0

        local vBtn = Instance.new("TextButton")
        vBtn.Size = UDim2.new(1, 0, 0, 24)
        vBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        vBtn.Text = model.Name .. " [" .. distVal .. "m]"
        vBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        vBtn.Font = Enum.Font.SourceSans
        vBtn.TextSize = 12
        vBtn.Parent = MapVehicleList
        Instance.new("UICorner", vBtn).CornerRadius = UDim.new(0, 4)
        
        vBtn.MouseButton1Click:Connect(function()
            selectedVehicleModel = model
            StatusLabel.Text = "Veículo/Moto Selecionado: " .. model.Name
            for _, b in ipairs(MapVehicleList:GetChildren()) do 
                if b:IsA("TextButton") then b.BackgroundColor3 = Color3.fromRGB(50, 50, 60) end 
            end
            vBtn.BackgroundColor3 = Color3.fromRGB(210, 105, 30)
        end)
    end

    local h = math.max(0, #foundModels * 28)
    MapVehicleList.CanvasSize = UDim2.new(0, 0, 0, h)
    StatusLabel.Text = "Identificados " .. #foundModels .. " carros/motos no raio de " .. vehicleEspPercentage .. "%."
end

