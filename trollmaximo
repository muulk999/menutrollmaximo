-- ==================== FUNÇÕES AUXILIARES ====================
local function findZimuObject()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if string.lower(obj.Name) == "meshes/zimu" or string.lower(obj.Name) == "zimu" then
            local part = obj
            if obj:IsA("Model") then part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
            if part and part:IsA("BasePart") then return part end
        end
    end
    return nil
end

local function findSpecificMallBase(targetName)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if string.lower(obj.Name) == string.lower(targetName) then
            local part = obj
            if obj:IsA("Model") then part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
            if part and part:IsA("BasePart") then return part end
        end
    end
    return nil
end


-- ==================== INPUTS E CONTROLES ====================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.W then keysDown.W = true; freeCamKeys.W = true end
    if input.KeyCode == Enum.KeyCode.A then keysDown.A = true; freeCamKeys.A = true end
    if input.KeyCode == Enum.KeyCode.S then keysDown.S = true; freeCamKeys.S = true end
    if input.KeyCode == Enum.KeyCode.D then keysDown.D = true; freeCamKeys.D = true end
    if input.KeyCode == Enum.KeyCode.Space then keysDown.Space = true; freeCamKeys.Space = true end
    if input.KeyCode == Enum.KeyCode.LeftShift then keysDown.Shift = true; freeCamKeys.Shift = true end
    
    if isDartTargetActive and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        local character = LocalPlayer.Character
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        local dartTool = (character and character:FindFirstChild("Dart")) or (backpack and backpack:FindFirstChild("Dart"))
        
        if dartTool and itemSelectedPlayer and itemSelectedPlayer.Character then
            local targetRoot = itemSelectedPlayer.Character:FindFirstChild("HumanoidRootPart") or itemSelectedPlayer.Character:FindFirstChild("Head")
            local dartRE = dartTool:FindFirstChild("DartRE")
            local toolBE = dartTool:FindFirstChild("ToolBE")
            
            if targetRoot then
                if dartTool.Parent ~= character then dartTool.Parent = character end
                if dartRE and dartRE:IsA("RemoteEvent") then pcall(function() dartRE:FireServer(targetRoot.Position, targetRoot) end) end
                if toolBE and toolBE:IsA("RemoteEvent") then pcall(function() toolBE:FireServer(targetRoot.Position, targetRoot) end) end
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then keysDown.W = false; freeCamKeys.W = false end
    if input.KeyCode == Enum.KeyCode.A then keysDown.A = false; freeCamKeys.A = false end
    if input.KeyCode == Enum.KeyCode.S then keysDown.S = false; freeCamKeys.S = false end
    if input.KeyCode == Enum.KeyCode.D then keysDown.D = false; freeCamKeys.D = false end
    if input.KeyCode == Enum.KeyCode.Space then keysDown.Space = false; freeCamKeys.Space = false end
    if input.KeyCode == Enum.KeyCode.LeftShift then keysDown.Shift = false; freeCamKeys.Shift = false end
end)

UserInputService.InputChanged:Connect(function(input)
    if isFreeCamActive and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Delta
        freeCamAngles = freeCamAngles - Vector2.new(delta.Y * 0.003, delta.X * 0.003)
        freeCamAngles = Vector2.new(math.clamp(freeCamAngles.X, -math.pi/2, math.pi/2), freeCamAngles.Y)
    end
end)


-- ==================== LOOP PRINCIPAL ====================
RunService.Heartbeat:Connect(function(deltaTime)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    -- Sistema de Hitbox
    if isHitboxExpanderActive then
        local mult = hitboxSizeMultiplier
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local char = p.Character
                local rootPart = char:FindFirstChild("HumanoidRootPart")
                if rootPart and rootPart:IsA("BasePart") then
                    if not rootPart:GetAttribute("OrigSize") then
                        rootPart:SetAttribute("OrigSize", rootPart.Size)
                    end
                    local origSize = rootPart:GetAttribute("OrigSize")
                    if mult > 1 then
                        rootPart.Size = origSize * mult
                        rootPart.Transparency = 0.5
                        rootPart.CanCollide = false
                    else
                        rootPart.Size = origSize
                        rootPart.Transparency = 1
                    end
                end
            end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            local nameLower = string.lower(obj.Name)
            if (nameLower == "dart" or nameLower == "handle" or nameLower == "projectile") and obj:IsA("BasePart") then
                if obj.Parent ~= myChar then
                    if not obj:GetAttribute("OrigSize") then obj:SetAttribute("OrigSize", obj.Size) end
                    local origSize = obj:GetAttribute("OrigSize")
                    obj.Size = (mult > 1) and (origSize * mult) or origSize
                end
            end
        end
    end

    if isDartTargetActive and itemSelectedPlayer and itemSelectedPlayer.Character and myRoot then
        local targetRoot = itemSelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    if isGhostModeActive and myRoot then
        if not ghostOriginalPos then ghostOriginalPos = myRoot.CFrame end
        if ghostFixedCameraCFrame then
            Camera.CameraType = Enum.CameraType.Scriptable
            Camera.CFrame = ghostFixedCameraCFrame
        end
        local tickNow = tick() * 30
        if math.floor(tickNow) % 2 == 0 then
            myRoot.CFrame = CFrame.new(ghostOriginalPos.Position.X, 5000, ghostOriginalPos.Position.Z)
        else
            myRoot.CFrame = ghostOriginalPos
        end
        myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end

    if isAriveContinuousActive and myRoot then
        local arivePart = findSpecificMallBase("arive")
        if arivePart then
            myRoot.CFrame = arivePart.CFrame * CFrame.new(ariveOffsets.Right, ariveOffsets.Height, ariveOffsets.Forward)
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    if isInfiniteFrontTpActive and selectedPlayer and selectedPlayer.Character and myRoot then
        local targetRoot = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            targetRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, -3)
            targetRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    if isCasaLoopActive and casaSelectedPlayer and casaSelectedPlayer.Character and myRoot then
        local targetRoot = casaSelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            local elapsedTime = tick() - casaLoopTimer
            casaMoverTime = casaMoverTime + (deltaTime * casaMoverSpeeds[currentCasaSpeedIndex])
            local maxDist = casaDistances[currentCasaDistIndex]
            local hOff = casaHeights[currentCasaHeightIndex]
            local offsetZ = math.sin(casaMoverTime) * maxDist

            if casaLoopStep == 1 then
                if elapsedTime >= casaTpDelay then
                    local zimuPart = findZimuObject()
                    if zimuPart then
                        local baseCF = zimuPart.CFrame * CFrame.new(0, hOff, 0)
                        myRoot.CFrame = baseCF
                        targetRoot.CFrame = baseCF * CFrame.new(0, 0, offsetZ)
                    end
                    if elapsedTime >= (casaTpDelay + 3) then
                        casaLoopTimer = tick()
                        casaLoopStep = 2
                    end
                end
            else
                local selectedMode = mallTypeNames[currentMallTypeIndex]
                local mallBase = nil
                if selectedMode == "Todos" then
                    local mallSubSteps = {"BackMall_enter", "FrountMall_enter", "arive"}
                    mallBase = findSpecificMallBase(mallSubSteps[(casaLoopStep - 1) % #mallSubSteps + 1])
                else
                    mallBase = findSpecificMallBase(selectedMode)
                end

                if elapsedTime >= casaTpDelay then
                    if mallBase then
                        local baseCF = mallBase.CFrame * CFrame.new(0, hOff, 0)
                        myRoot.CFrame = baseCF
                        targetRoot.CFrame = baseCF * CFrame.new(0, 0, offsetZ)
                    end
                    if elapsedTime >= (casaTpDelay + 3) then
                        casaLoopTimer = tick()
                        if selectedMode == "Todos" then
                            casaLoopStep = casaLoopStep + 1
                            if casaLoopStep > 4 then casaLoopStep = 1 end
                        else
                            casaLoopStep = 1
                        end
                    end
                end
            end
        end
    end

    if isSitOnHeadActive and interacaoSelectedPlayer and interacaoSelectedPlayer.Character and myRoot and hum then
        local targetRoot = interacaoSelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            hum.Sit = true
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, sitHeights[currentSitHeightIndex], 0)
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    if isFreeCamActive then
        Camera.CameraType = Enum.CameraType.Scriptable
        local camRot = CFrame.Angles(0, freeCamAngles.Y, 0) * CFrame.Angles(freeCamAngles.X, 0, 0)
        local moveDir = Vector3.new(0, 0, 0)
        if freeCamKeys.W then moveDir = moveDir + Vector3.new(0, 0, -1) end
        if freeCamKeys.S then moveDir = moveDir + Vector3.new(0, 0, 1) end
        if freeCamKeys.A then moveDir = moveDir + Vector3.new(-1, 0, 0) end
        if freeCamKeys.D then moveDir = moveDir + Vector3.new(1, 0, 0) end
        if freeCamKeys.Space then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if freeCamKeys.Shift then moveDir = moveDir + Vector3.new(0, -1, 0) end
        freeCamPos = freeCamPos + (camRot * moveDir) * (60 * deltaTime)
        Camera.CFrame = CFrame.new(freeCamPos) * camRot
    end

    if isSpectateActive and spectatorTargetPlayer and spectatorTargetPlayer.Character then
        local tHum = spectatorTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if tHum then
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CameraSubject = tHum
        end
    end

    if isAntiChuteAtivo and myRoot then
        if not originalPositionCFrame then originalPositionCFrame = myRoot.CFrame
        elseif (myRoot.Position - originalPositionCFrame.Position).Magnitude > 15 and not isKickFlinging then
            myRoot.CFrame = originalPositionCFrame
        end
    end

    if isSpeedEnabled and hum then
        hum.WalkSpeed = 16 + (speedPercentage / 100) * 234
    end

    if isFlying and myRoot and bodyGyro and bodyVelocity then
        local cam = workspace.CurrentCamera
        bodyGyro.CFrame = cam.CFrame
        local dir = Vector3.new(0,0,0)
        if keysDown.W then dir = dir + cam.CFrame.LookVector end
        if keysDown.S then dir = dir - cam.CFrame.LookVector end
        if keysDown.A then dir = dir - cam.CFrame.RightVector end
        if keysDown.D then dir = dir + cam.CFrame.RightVector end
        if keysDown.Space then dir = dir + Vector3.new(0,1,0) end
        if keysDown.Shift then dir = dir - Vector3.new(0,1,0) end
        bodyVelocity.velocity = dir * flySpeed
    end

    if isKickFlinging and kickFlingTargetPlayer and kickFlingTargetPlayer.Character and myRoot then
        local tRoot = kickFlingTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            if isVoltarNoLugarAtivo and not originalPositionCFrame then originalPositionCFrame = myRoot.CFrame end
            myRoot.CFrame = tRoot.CFrame
            tRoot.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
            tRoot.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
        end
    end

    if isFollowItemActive and itemSelectedPlayer and itemSelectedPlayer.Character and myRoot then
        local tRoot = itemSelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            if myChar and backpack then
                local item = myChar:FindFirstChild("babycar_c") or backpack:FindFirstChild("babycar_c")
                if item and item:IsA("Tool") and item.Parent ~= myChar then item.Parent = myChar end
            end
            local offsetValue = math.sin(tick() * 8) * 4
            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, offsetValue)
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    if isMyCharOrbiting and selectedPlayer and selectedPlayer.Character and myRoot then
        local tRoot = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            myOrbitAngle = myOrbitAngle + (orbitSpeedsVals[currentMyOrbitSpeedIndex] * (deltaTime * 60))
            myRoot.CFrame = tRoot.CFrame * CFrame.new(math.cos(myOrbitAngle) * orbitDistances[currentDistanceIndex], orbitHeights[currentHeightIndex], math.sin(myOrbitAngle) * orbitDistances[currentDistanceIndex])
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    if selectedPlayer and selectedPlayer.Character and myRoot and not isMyCharOrbiting and not isDartTargetActive then
        local tRoot = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        local tHum = selectedPlayer.Character:FindFirstChild("Humanoid")
        if tRoot and tHum and tHum.Health > 0 then
            if isOrbiting then
                orbitAngle = orbitAngle + (orbitSpeedsVals[currentSpeedIndex] * (deltaTime * 60))
                tRoot.CFrame = myRoot.CFrame * CFrame.new(math.cos(orbitAngle) * orbitDistances[currentDistanceIndex], orbitHeights[currentHeightIndex], math.sin(orbitAngle) * orbitDistances[currentDistanceIndex])
                tRoot.AssemblyLinearVelocity = Vector3.new(0,0,0)
            elseif isTeleporting then
                if tick() - lastTeleportTick >= teleportInterval then
                    lastTeleportTick = tick()
                    tRoot.CFrame = myRoot.CFrame * CFrame.new(0, 5, -3)
                    tRoot:ApplyImpulse(Vector3.new(0, -tRoot.AssemblyMass * 150, 0))
                end
            end
        end
    end
end)
