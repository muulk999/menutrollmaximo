-- ==================== LOOP PRINCIPAL ====================
RunService.Heartbeat:Connect(function(deltaTime)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    -- Anti Chute
    if isAntiChuteAtivo and myRoot then
        if not originalPositionCFrame then
            originalPositionCFrame = myRoot.CFrame
        else
            local distancia = (myRoot.Position - originalPositionCFrame.Position).Magnitude
            if distancia > 15 and not isKickFlinging then
                myRoot.CFrame = originalPositionCFrame
                myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                myRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                StatusLabel.Text = "Anti Chute ativado: Retornado ao lugar!"
            end
        end
    end

    -- Speed
    if isSpeedEnabled and hum then
        hum.WalkSpeed = 16 + (speedPercentage / 100) * 234
    end

    -- Fly
    if isFlying and myRoot and bodyGyro and bodyVelocity then
        local cam = workspace.CurrentCamera
        bodyGyro.CFrame = cam.CFrame
        local dir = Vector3.new(0,0,0)
        if keysDown.W then dir = dir + cam.CFrame.LookVector end
        if keysDown.S then dir = dir - cam.CFrame.LookVector end
        if keysDown.A then dir = dir - cam.CFrame.RightVector end
        if keysDown.D then dir = dir + cam.CFrame.RightVector end
        if keysDown.Space then dir = dir + Vector3.new(0,1,0) end
        if keysDown.Shift then dir = dir - Vector3.new(0,1,0) end
        bodyVelocity.velocity = dir * flySpeed
    end

    -- Kick Fling
    if isKickFlinging and kickFlingTargetPlayer and kickFlingTargetPlayer.Character and myRoot then
        local tRoot = kickFlingTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            if isVoltarNoLugarAtivo and not originalPositionCFrame then
                originalPositionCFrame = myRoot.CFrame
            end

            myRoot.CFrame = tRoot.CFrame
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            tRoot.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
            tRoot.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
        end
    end

    -- Seguir com o Item (babycar_c) com velocidade customizável
    if isFollowItemActive and itemSelectedPlayer and itemSelectedPlayer.Character and myRoot then
        local tRoot = itemSelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
            if myChar and backpack then
                local item = myChar:FindFirstChild("babycar_c") or backpack:FindFirstChild("babycar_c")
                if item and item:IsA("Tool") and item.Parent ~= myChar then
                    item.Parent = myChar
                end
            end

            local speedMultiplier = followItemSpeeds[currentFollowItemSpeedIndex].val
            local timeFactor = tick() * speedMultiplier
            local offsetValue = math.sin(timeFactor) * 4
            
            myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, offsetValue)
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    -- MoverModel (Vai e Vem do Carro/Moto em cima do Player selecionado)
    if isMoverModelActive and selectedVehicleModel and selectedVehicleModel.Parent and vehicleTpTargetPlayer and vehicleTpTargetPlayer.Character then
        local motoModel = selectedVehicleModel
        local motoPart = motoModel.PrimaryPart or motoModel:FindFirstChildWhichIsA("BasePart")
        local tRoot = vehicleTpTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if motoPart and tRoot then
            moverModelTime = moverModelTime + (deltaTime * moverModelSpeeds[currentMoverModelSpeedIndex].val)
            local maxDist = moverModelDistances[currentMoverModelDistIndex].val
            local hOff = moverModelHeights[currentMoverModelHeightIndex]
            
            local offsetZ = math.sin(moverModelTime) * maxDist
            local targetCF = tRoot.CFrame * CFrame.new(0, hOff, offsetZ)
            
            if motoModel.PrimaryPart then
                motoModel:SetPrimaryPartCFrame(targetCF)
                motoModel.PrimaryPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            else
                for _, p in ipairs(motoModel:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.CFrame = targetCF
                        p.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        break
                    end
                end
            end
        end
    end

    -- Veículos (Girar em volta de você)
    if isVehiclesOrbiting and myRoot then
        local val = vehicleSpeeds[currentVehicleSpeedIndex].val
        vehicleAngle = vehicleAngle + (val * (deltaTime * 60))
        local rad = vehicleDistances[currentVehicleDistIndex].val
        local hOff = vehicleHeights[currentVehicleHeightIndex]
        local found = {}
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("VehicleSeat") or obj:IsA("Seat") then
                local m = obj.Parent
                if m and isRealVehicle(m) and m ~= myChar then
                    local added = false
                    for _, v in ipairs(found) do if v == m then added = true break end end
                    if not added then
                        local part = m.PrimaryPart or obj
                        if (part.Position - myRoot.Position).Magnitude <= 50 then table.insert(found, m) end
                    end
                end
            end
        end
        for i, m in ipairs(found) do
            if m.Parent then
                local ang = vehicleAngle + ((i / #found) * (math.pi * 2))
                local cf = myRoot.CFrame * CFrame.new(math.cos(ang) * rad, hOff, math.sin(ang) * rad)
                if m.PrimaryPart then
                    m:SetPrimaryPartCFrame(cf)
                    m.PrimaryPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                else
                    for _, p in ipairs(m:GetDescendants()) do
                        if p:IsA("BasePart") then p.CFrame = cf; p.AssemblyLinearVelocity = Vector3.new(0,0,0); break end
                    end
                end
            end
        end
    end

    -- Seu boneco girando em volta do jogador selecionado
    if isMyCharOrbiting and selectedPlayer and selectedPlayer.Character and myRoot then
        local tRoot = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            myOrbitAngle = myOrbitAngle + (orbitSpeeds[currentMyOrbitSpeedIndex].val * (deltaTime * 60))
            local rad = orbitDistances[currentDistanceIndex].val
            local hOff = orbitHeights[currentHeightIndex]
            
            myRoot.CFrame = tRoot.CFrame * CFrame.new(math.cos(myOrbitAngle) * rad, hOff, math.sin(myOrbitAngle) * rad)
            myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end

    -- Órbita Clássica ou TP Player
    if selectedPlayer and selectedPlayer.Character and myRoot and not isMyCharOrbiting then
        local tRoot = selectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        local tHum = selectedPlayer.Character:FindFirstChild("Humanoid")
        if tRoot and tHum and tHum.Health > 0 then
            if isOrbiting then
                orbitAngle = orbitAngle + (orbitSpeeds[currentSpeedIndex].val * (deltaTime * 60))
                local rad = orbitDistances[currentDistanceIndex].val
                local hOff = orbitHeights[currentHeightIndex]
                tRoot.CFrame = myRoot.CFrame * CFrame.new(math.cos(orbitAngle) * rad, hOff, math.sin(orbitAngle) * rad)
                tRoot.AssemblyLinearVelocity = Vector3.new(0,0,0)
            elseif isTeleporting then
                if tick() - lastTeleportTick >= teleportInterval then
                    lastTeleportTick = tick()
                    tRoot.CFrame = myRoot.CFrame * CFrame.new(0, 5, -3)
                    tRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    tRoot:ApplyImpulse(Vector3.new(0, -tRoot.AssemblyMass * 150, 0))
                end
            end
        end
    end
end)
